{
  "$description": "Guaraná do Homer · tokens de marca. Os mesmos valores de tokens.css, para o site (Astro) e o sistema em Flutter (fase 3).",
  "cor": {
    "creme": { "$value": "#F5E9D6", "$type": "color", "$description": "Fundo principal (~50%)" },
    "vermelho": { "$value": "#B5252B", "$type": "color", "$description": "Marca, botões, títulos de destaque (~25%)" },
    "semente": { "$value": "#2B1B17", "$type": "color", "$description": "Texto e contornos (~10%)" },
    "polpa": { "$value": "#FFFDF8", "$type": "color", "$description": "Letra sobre vermelho, cartões (~10%)" },
    "verde": { "$value": "#2E5E3E", "$type": "color", "$description": "Só detalhe (folha, selo de Maués); nunca fundo (~3%)" },
    "ambar": { "$value": "#E8892B", "$type": "color", "$description": "Só Modo Turbo; texto nele em Semente (~2%)" },
    "vermelhoEscuro": { "$value": "#8F1D22", "$type": "color", "$description": "Hover e pressionado do botão" },
    "textoSuave": { "$value": "#6B5148", "$type": "color", "$description": "Texto secundário (6,0:1 no Creme)" },
    "borda": { "$value": "#E3D2B6", "$type": "color", "$description": "Divisórias no Creme; nunca texto" }
  },
  "fonte": {
    "titulo": { "$value": ["Baloo 2", "Fredoka", "system-ui", "sans-serif"], "$type": "fontFamily" },
    "texto": { "$value": ["Nunito Sans", "Inter", "system-ui", "sans-serif"], "$type": "fontFamily" },
    "pesoTitulo": { "$value": 800, "$type": "fontWeight" },
    "pesoTexto": { "$value": 400, "$type": "fontWeight" },
    "pesoForte": { "$value": 800, "$type": "fontWeight" }
  },
  "tamanho": {
    "textoXs": { "$value": "13px", "$type": "dimension" },
    "textoSm": { "$value": "15px", "$type": "dimension" },
    "textoBase": { "$value": "17px", "$type": "dimension" },
    "textoLg": { "$value": "20px", "$type": "dimension" },
    "textoXl": { "$value": "24px", "$type": "dimension" },
    "tituloSm": { "$value": "24-30px", "$type": "dimension", "$description": "clamp no CSS" },
    "tituloMd": { "$value": "30-44px", "$type": "dimension", "$description": "clamp no CSS" },
    "tituloLg": { "$value": "38-68px", "$type": "dimension", "$description": "clamp no CSS" }
  },
  "raio": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "pilula": { "$value": "999px", "$type": "dimension" }
  },
  "layout": {
    "larguraMax": { "$value": "1200px", "$type": "dimension" },
    "margemLateral": { "$value": "16px", "$type": "dimension" },
    "alvoToque": { "$value": "48px", "$type": "dimension" },
    "breakpointTablet": { "$value": "600px", "$type": "dimension" },
    "breakpointComputador": { "$value": "1024px", "$type": "dimension" }
  }
}
